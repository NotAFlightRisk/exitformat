{
  "name": "exitformat",
  "version": "0.1.0",
  "private": true,
  "description": "How to get your data out of an online service, what formats you get, and where you can take it",
  "homepage": "https://exitformat.peng.ly",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/exitformat.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "validate": "node scripts/validate.ts",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@sentry/browser": "^11.12.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "satori": "^0.63.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
